# Required environment variables for the VectorDB Frame Service
PINECONE_API_KEY=your-pinecone-api-key
REPLICATE_API_TOKEN=your-replicate-api-token
GEMINI_API_KEY=your-gemini-api-key-here

# MongoDB settings for frame storage
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB_NAME=pdd_vectordb

# Optional overrides (shown with defaults)
# PINECONE_INDEX_NAME=framesdb-v3
# PINECONE_DIMENSION=768
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# CLIP_MODEL_ID=openai/clip-vit-base-patch32
# SCENE_THRESHOLD=9.0
# OMNIPARSER_MODEL=microsoft/omniparser-v2:49cf3d41b8d3aca1360514e83be4c97131ce8f0d99abfc365526d8384caa88df
